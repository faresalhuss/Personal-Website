# Newsletter — Beehiiv. Until both are set, the subscribe form falls back to a
# local stub (writes to data/subscribers.json in dev) so the form still works.
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# Newsletter archive — public beehiiv RSS feed (Settings → RSS → New RSS Feed).
# Powers the /newsletter archive + homepage "Recent issues". Not a secret, but
# kept in env so it can change without a redeploy. Empty = archive renders empty
# (and is noindex), so nothing breaks.
BEEHIIV_RSS_URL=

# YouTube — only needed once the channel exists and you swap the placeholder
# for the <LatestVideo /> component. Safe to leave empty until then.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Lead magnet — secret used to sign the short-lived download grant for the
# /reading-list PDF. Without it, a dev-only fallback is used (fine locally, NOT
# for production). Generate one with:  openssl rand -base64 32
DOWNLOAD_SIGNING_SECRET=

# Contact form — Resend (free tier: 3k emails/mo). Until RESEND_API_KEY is set,
# the contact form falls back to a local stub (writes to
# data/contact-messages.json in dev) so the form still works. The 3 mailto
# links work regardless. The From address defaults to the verified
# contact.fareshusseini.com subdomain; set CONTACT_FROM_EMAIL only to override.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Fa'res Husseini <noreply@contact.fareshusseini.com>"
